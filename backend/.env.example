DATABASE_URL=sqlite:///./pricewatcher.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5174,http://localhost:5173
REDIS_URL=redis://localhost:6379/0
DEFAULT_CHECK_INTERVAL_MINUTES=360

# --- alerts ---
# console = emails are only printed in the worker log (good for dev); smtp = really send
EMAIL_BACKEND=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Price Watcher <alerts@yourdomain.com>
# Set to true ONLY in local dev to test webhooks against localhost receivers
ALLOW_PRIVATE_WEBHOOKS=false

# --- AI verdict (optional) ---
# Leave empty to use the built-in rule-based verdict. Same kind of key as in your games dashboard.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AI_HOURLY_LIMIT=20
